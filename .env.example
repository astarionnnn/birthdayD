# ============================================================
#  Birthday Gift — Environment Variables
#  Copy file ini ke .env.local dan isi nilainya
# ============================================================

# ── URL publik (dipakai di sisi client & server) ──────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
# Dapatkan dari: https://supabase.com/dashboard → Settings → API

# NEXT_PUBLIC_ boleh terekspos ke browser (anon key, RLS aktif)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SERVICE ROLE KEY — RAHASIA, hanya dipakai di server (API routes)
# JANGAN pernah diberi prefix NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Telegram Bot ──────────────────────────────────────────────
# Dapatkan dari: @BotFather di Telegram
# Hanya dipakai di sisi server — TIDAK pernah diekspos ke browser
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
